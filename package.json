{
  "name": "daejang",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "axios": "^1.18.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @daejang/web",
    "dev:local": "./scripts/dev-local.sh",
    "dev:api": "npm run dev --workspace @daejang/web-api",
    "backend:start": "node scripts/host-backend.mjs start",
    "backend:stop": "node scripts/host-backend.mjs stop",
    "backend:restart": "node scripts/host-backend.mjs restart",
    "backend:status": "node scripts/host-backend.mjs status",
    "backend:logs": "node scripts/host-backend.mjs logs",
    "start:web-api:host-production": "npm run build --workspace @daejang/web-api && node scripts/start-host-web-api.mjs",
    "build": "npm run build --workspace @daejang/web --workspace @daejang/web-api --workspace @daejang/edge --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "preview": "npm run preview --workspace @daejang/web"
  }
}
