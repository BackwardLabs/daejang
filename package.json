{
  "name": "daejang",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "axios": "^1.18.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @daejang/web",
    "dev:local": "./scripts/dev-local.sh",
    "dev:api": "npm run dev --workspace @daejang/web-api",
    "start:web-api:host-production": "node scripts/start-web-api-host-production.mjs",
    "backend:start": "node scripts/host-backend.mjs start",
    "backend:upbit-collector-start": "node scripts/host-backend.mjs upbit-collector-start",
    "backend:stop": "node scripts/host-backend.mjs stop",
    "backend:restart": "node scripts/host-backend.mjs restart",
    "backend:status": "node scripts/host-backend.mjs status",
    "backend:logs": "node scripts/host-backend.mjs logs",
    "backend:supervise": "node scripts/host-backend.mjs supervise",
    "backend:install-autostart": "node scripts/host-backend.mjs install-autostart",
    "backend:share-runtime": "node scripts/host-backend.mjs share-runtime",
    "mac-studio:status": "bash scripts/mac-studio-release.sh status",
    "mac-studio:preflight": "bash scripts/mac-studio-release.sh preflight",
    "mac-studio:sync": "bash scripts/mac-studio-release.sh sync",
    "mac-studio:deploy-indexer": "bash scripts/mac-studio-release.sh deploy-indexer",
    "mac-studio:deploy-backend": "bash scripts/mac-studio-release.sh deploy-backend",
    "mac-studio:deploy": "bash scripts/mac-studio-release.sh deploy",
    "build": "npm run build --workspace @daejang/web --workspace @daejang/web-api --workspace @daejang/edge --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/host-backend.test.mjs scripts/install-report-attestation-runtime.test.mjs scripts/mac-studio-release.test.mjs",
    "test:e2e:sources": "node scripts/test-source-pipeline-e2e.mjs",
    "typecheck:report-attestations:local-v1": "tsc -p scripts/tsconfig.report-attestation-local-v1.json --pretty false",
    "test:report-attestations:local-v1": "bash scripts/run-report-attestation-local-v1.sh --test",
    "dev:report-attestations:local-v1": "exec bash scripts/run-report-attestation-local-v1.sh --serve",
    "install:report-attestations:runtime": "node scripts/install-report-attestation-runtime.mjs",
    "preview": "npm run preview --workspace @daejang/web"
  }
}
