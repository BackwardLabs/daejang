{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daejang",
  "main": "./apps/edge/src/index.ts",
  "compatibility_date": "2026-07-25",
  "keep_vars": true,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
