# Copy to /Users/Shared/Projects/01_Daejang/daejang-reviewroom/.env.delivery-worker.
# DAEJANG_DATABASE_URL is a central daejang-db REVIEWROOM-delivery-only
# credential. It is not the ReviewRoom Postgres URL.
DAEJANG_DATABASE_URL=postgresql://replace-with-reviewroom-delivery-user:replace-with-password@daejang-db-postgres-1:5432/replace-with-daejang-db

# Must equal the API's RESOLUTION_INGEST_API_TOKEN.
REVIEWROOM_RESOLUTION_INGEST_TOKEN=replace-with-existing-resolution-ingest-token

# Compose injects REVIEWROOM_INTERNAL_API_URL=http://api:8081.
# This true value permits that private Compose-network HTTP hop only.
REVIEWROOM_DELIVERY_ALLOW_INSECURE_HTTP=true
REVIEWROOM_DELIVERY_POLL_INTERVAL_MS=1000
REVIEWROOM_DELIVERY_LEASE_SECONDS=30
REVIEWROOM_DELIVERY_BATCH_SIZE=20
REVIEWROOM_DELIVERY_REQUEST_TIMEOUT_MS=10000
REVIEWROOM_DELIVERY_RETRY_BASE_MS=1000
REVIEWROOM_DELIVERY_RETRY_MAX_MS=900000
REVIEWROOM_DELIVERY_WORKER_ID=production-reviewroom-delivery-1
