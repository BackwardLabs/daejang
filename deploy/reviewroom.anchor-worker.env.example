# Copy to /Users/Shared/Projects/01_Daejang/daejang-reviewroom/.env.anchor-worker.
# Copy only the existing ReviewRoom chain/anchor values. This is the only
# ReviewRoom workload file that may contain ANCHOR_PRIVATE_KEY.
DATABASE_URL=postgresql://reviewroom:replace-with-reviewroom-postgres-password@postgres:5432/reviewroom
CHAIN_RPC_URL=https://replace-with-giwa-rpc
CHAIN_ID=replace-with-giwa-chain-id
REVIEW_PROOF_REGISTRY_ADDRESS=0xreplace-with-registry-address
REVIEW_PROOF_REGISTRY_DEPLOYMENT_ID=replace-with-registry-deployment-id
REVIEW_PROOF_REGISTRY_CODE_HASH=0xreplace-with-registry-runtime-code-hash
REVIEW_PROOF_REGISTRY_DEPLOYMENT_BLOCK=replace-with-registry-deployment-block

ANCHOR_PRIVATE_KEY=0xreplace-with-attester-private-key
ANCHOR_CONFIRMATIONS=2
ANCHOR_POLL_INTERVAL_MS=1000
ANCHOR_LEASE_SECONDS=30
ANCHOR_MISSING_TRANSACTION_GRACE_SECONDS=300
ANCHOR_BATCH_SIZE=20
ANCHOR_WORKER_ID=production-reviewroom-anchor-1
