# Keep image data and password hashes outside the Git checkout.
REGISTRY_DATA_DIR=/Users/Shared/DaejangRegistry/data
REGISTRY_AUTH_DIR=/Users/Shared/DaejangRegistry/auth

# The Registry only listens on loopback. Tailscale Serve forwards HTTPS here.
REGISTRY_LOOPBACK_PORT=5050

# Optional. The script finds either PATH tailscale or the macOS app by default.
TAILSCALE_CLI=/Applications/Tailscale.app/Contents/MacOS/Tailscale
