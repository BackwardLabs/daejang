# Copy to /Users/Shared/Projects/01_Daejang/daejang-reviewroom/.env.api.
# Copy the corresponding values from daejang-reviewroom/.env; do not copy the
# anchor private key or any delivery-worker-only value into this file.
DATABASE_URL=postgresql://reviewroom:replace-with-reviewroom-postgres-password@postgres:5432/reviewroom

INTERNAL_API_TOKEN=replace-with-existing-internal-api-token
RESOLUTION_INGEST_API_TOKEN=replace-with-existing-resolution-ingest-token
APPLICATION_RECEIPT_API_TOKEN=replace-with-existing-application-receipt-token
PROOF_VECTOR_API_TOKEN=replace-with-existing-proof-vector-token

REVIEW_COMMITMENT_KEY_BASE64=replace-with-existing-commitment-key
MAX_RESPONSE_REVISIONS_PER_CASE=10

CHAIN_RPC_URL=https://replace-with-giwa-rpc
PROOF_VECTOR_MIN_CONFIRMATIONS=2
CHAIN_ID=replace-with-giwa-chain-id
REVIEW_PROOF_REGISTRY_ADDRESS=0xreplace-with-registry-address
REVIEW_PROOF_REGISTRY_DEPLOYMENT_ID=replace-with-registry-deployment-id
REVIEW_PROOF_REGISTRY_CODE_HASH=0xreplace-with-registry-runtime-code-hash

# Keep false unless the legacy batch/case API remains intentionally enabled.
LEGACY_REVIEW_API_ENABLED=false
# When LEGACY_REVIEW_API_ENABLED=true, set exactly one of DAEJANG_JWKS_URL or
# DAEJANG_JWT_SECRET, and also set issuer, audience and encryption key.
# DAEJANG_JWKS_URL=https://replace-with-daejang-jwks
# DAEJANG_JWT_SECRET=replace-with-daejang-jwt-secret
# DAEJANG_JWT_ISSUER=replace-with-daejang-jwt-issuer
# DAEJANG_JWT_AUDIENCE=replace-with-daejang-jwt-audience
# REVIEW_ENCRYPTION_KEY_BASE64=replace-with-existing-encryption-key
# REVIEW_ENCRYPTION_KEY_ID=production-v1
