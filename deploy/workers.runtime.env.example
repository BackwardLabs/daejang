# Copy outside every repository, complete with test-only values, and chmod 600.
# The Compose file injects local PostgreSQL URLs and local writable directories;
# do not place production URLs, passwords, private keys, or production paths here.

# Source and EVM posting workers use the same test signing authority.
DAEJANG_PUBLICATION_POLICY_TRUST_KEY=

# Tax requires a separate 32-byte Ed25519 trust-key value and a complete test
# release bundle mounted under /run/daejang/tax.
DAEJANG_TAXD_PUBLICATION_POLICY_TRUST_KEY=
DAEJANG_TAXD_INPUT_MODE=LEDGER_PUBLICATION
DAEJANG_TAXD_POLICY_FILE=/run/daejang/tax/policy.json
DAEJANG_TAXD_OWNERSHIP_FILE=/run/daejang/tax/ownership.json
DAEJANG_TAXD_ACTIVATION_SET_FILE=/run/daejang/tax/activation-set.json
DAEJANG_TAXD_ACTIVATION_SET_SHA256=
DAEJANG_TAXD_DOWNSTREAM_PROFILE_FILE=/run/daejang/tax/downstream-profile.json
DAEJANG_TAXD_QUOTE_SNAPSHOT_FILE=/run/daejang/tax/quote-snapshot.json
DAEJANG_TAXD_CANDIDATE_DIGEST=
DAEJANG_TAXD_PRODUCER_VERSION=
DAEJANG_TAXD_SCHEMA_COMMIT=
DAEJANG_TAXD_JIT_COMMIT=
DAEJANG_TAXD_DB_COMMIT=
DAEJANG_TAXD_DB_MIGRATION_VERSION=73
DAEJANG_TAXD_TAX_COMMIT=
DAEJANG_TAXD_CATALOG_SHA256=
