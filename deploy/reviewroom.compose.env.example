# Copy this file to the deploy user's private runtime directory, for example:
#   $HOME/Library/Application Support/GIWA/production/reviewroom/compose.env
# Then set mode 600. Do not store the resulting file in a Git checkout.
#
# scripts/mac-studio-release.sh always injects REVIEWROOM_IMAGE_REF from the
# approved Release manifest. Do not set REVIEWROOM_IMAGE_REF here.

REVIEWROOM_POSTGRES_PASSWORD=replace-with-a-random-postgres-password

# Use absolute paths. Each file contains only the credentials required by its
# one workload; no workload shares another workload's secrets.
REVIEWROOM_MIGRATE_ENV_FILE=/secure/path/reviewroom/migrate.env
REVIEWROOM_API_ENV_FILE=/secure/path/reviewroom/api.env
REVIEWROOM_ANCHOR_ENV_FILE=/secure/path/reviewroom/anchor-worker.env
REVIEWROOM_DELIVERY_ENV_FILE=/secure/path/reviewroom/delivery-worker.env
