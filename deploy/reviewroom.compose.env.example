# Copy this file to the ignored deployment env path used by the Mac Studio:
#   /Users/Shared/Projects/01_Daejang/daejang/deploy/reviewroom.env
# Then set owner backwardlabs, group upside and mode 660. This follows the
# existing production.env and daejang-db/.env deployment convention.
#
# scripts/mac-studio-release.sh always injects REVIEWROOM_IMAGE_REF from the
# approved Release manifest. Do not set REVIEWROOM_IMAGE_REF here.

REVIEWROOM_POSTGRES_PASSWORD=replace-with-a-random-hex-password

# Use absolute paths. Each file contains only the credentials required by its
# one workload; no workload shares another workload's secrets.
REVIEWROOM_MIGRATE_ENV_FILE=/Users/Shared/Projects/01_Daejang/daejang-reviewroom/.env.migrate
REVIEWROOM_API_ENV_FILE=/Users/Shared/Projects/01_Daejang/daejang-reviewroom/.env.api
REVIEWROOM_ANCHOR_ENV_FILE=/Users/Shared/Projects/01_Daejang/daejang-reviewroom/.env.anchor-worker
REVIEWROOM_DELIVERY_ENV_FILE=/Users/Shared/Projects/01_Daejang/daejang-reviewroom/.env.delivery-worker
