PUBLIC_ORIGIN=https://daejang.backwardlabs.io
# Engine image build also requires GH_PAT in the invoking shell. Do not store it here.
PUBLIC_TLS_PORT=8443
PUBLIC_TLS_CERT_PATH=/secure/path/public-cert.pem
PUBLIC_TLS_KEY_PATH=/secure/path/public-key.pem
WEB_DATABASE_URL=postgres://daejang_web_app:REPLACE@db.internal/daejang
SOURCE_DATABASE_URL=postgres://daejang_source_app:REPLACE@db.internal/daejang
QUERY_DATABASE_URL=postgres://daejang_query_app:REPLACE@db.internal/daejang
REPORT_DATABASE_URL=postgres://daejang_event_app:REPLACE@db.internal/daejang
REVIEW_DATABASE_URL=postgres://daejang_event_app:REPLACE@db.internal/daejang
# Until a narrower artifact-only role is introduced, this role supplies artifactstore.Put.
REVIEW_ARTIFACT_DATABASE_URL=postgres://daejang_source_app:REPLACE@db.internal/daejang
REVIEW_ARTIFACT_ROOT=/var/lib/daejang/review-artifacts/objects
REVIEW_ARTIFACT_TEMP=/var/lib/daejang/review-artifacts/tmp
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes
ENGINE_SERVER_CERT_PATH=/secure/path/engine-server-cert.pem
ENGINE_SERVER_KEY_PATH=/secure/path/engine-server-key.pem
ENGINE_CLIENT_CA_PATH=/secure/path/engine-client-ca.pem
ENGINE_WEB_API_CLIENT_DNS_NAME=web-api.internal
ENGINE_CA_PATH=/secure/path/engine-ca.pem
WEB_ENGINE_CLIENT_CERT_PATH=/secure/path/web-engine-client-cert.pem
WEB_ENGINE_CLIENT_KEY_PATH=/secure/path/web-engine-client-key.pem
ENGINE_PROBE_CERT_PATH=/secure/path/probe-client-cert.pem
ENGINE_PROBE_KEY_PATH=/secure/path/probe-client-key.pem
