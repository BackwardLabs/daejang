PUBLIC_ORIGIN=https://daejang.backwardlabs.io
# Engine image build also requires GH_PAT in the invoking shell. Do not store it here.
PUBLIC_TLS_PORT=8443
PUBLIC_TLS_CERT_PATH=/secure/path/public-cert.pem
PUBLIC_TLS_KEY_PATH=/secure/path/public-key.pem
# Both supported chains use one team-owned Alchemy application. Pin the
# lowercase SHA-256 of its path credential so a personal key cannot be used
# accidentally. The supervisor performs one eth_chainId request per chain
# before starting any core service.
ENV_RPC_URL_ETHEREUM_MAINNET=https://eth-mainnet.g.alchemy.com/v2/replace-with-team-credential
ENV_RPC_URL_OPTIMISM_MAINNET=https://opt-mainnet.g.alchemy.com/v2/replace-with-team-credential
GIWA_RPC_SHARED_CREDENTIAL_SHA256=replace-with-lowercase-sha256
# Created by the daejang-db Compose project. Keep PostgreSQL private.
DAEJANG_DB_NETWORK=daejang-db_default
WEB_DATABASE_URL=postgres://daejang_web_app:REPLACE@postgres:5432/daejang
# One-shot operator command only. Never pass this URL to the Web API service.
IDENTITY_PROVISIONER_DATABASE_URL=postgres://daejang_identity_provisioner:REPLACE@postgres:5432/daejang
SOURCE_DATABASE_URL=postgres://daejang_source_app:REPLACE@postgres:5432/daejang
QUERY_DATABASE_URL=postgres://daejang_query_app:REPLACE@postgres:5432/daejang
REPORT_DATABASE_URL=postgres://daejang_event_app:REPLACE@postgres:5432/daejang
REVIEW_DATABASE_URL=postgres://daejang_event_app:REPLACE@postgres:5432/daejang
# Until a narrower artifact-only role is introduced, this role supplies artifactstore.Put.
REVIEW_ARTIFACT_DATABASE_URL=postgres://daejang_source_app:REPLACE@postgres:5432/daejang
REVIEW_ARTIFACT_ROOT=/var/lib/daejang/review-artifacts/objects
REVIEW_ARTIFACT_TEMP=/var/lib/daejang/review-artifacts/tmp
# JIT artifacts must survive immutable application release changes. The host
# defaults to GIWA_HOST_RUNTIME_ROOT/artifacts/jit/*; prelaunch overrides may
# point at another durable volume.
# GIWA_JIT_ARTIFACT_ROOT=/var/lib/daejang/jit-artifacts/objects
# GIWA_JIT_ARTIFACT_TEMP=/var/lib/daejang/jit-artifacts/tmp

SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=43200
SIGNUP_SESSION_TTL_SECONDS=3600
# MVP signup is active without an external identity-verification provider.
# Authentication and required legal consent still apply before activation.
SIGNUP_ENABLED=true
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Callback URLs are fixed by PUBLIC_ORIGIN:
# https://daejang.backwardlabs.io/api/v1/auth/oauth/{naver|google|kakao}/callback
OAUTH_ENABLED_PROVIDERS=naver,google,kakao
OAUTH_TRANSACTION_TTL_SECONDS=600
OAUTH_STATE_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Generate with: openssl rand -base64 32
OAUTH_TRANSACTION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
NAVER_CLIENT_ID=replace-with-naver-client-id
NAVER_CLIENT_SECRET=replace-with-naver-client-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

EMAIL_AUTH_ENABLED=true
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=GIWA <no-reply@auth.backwardlabs.io>

# Actual FINAL report download payment (GIWA Sepolia x402 v2)
X402_REPORT_PAYMENTS_ENABLED=false
X402_FACILITATOR_URL=https://x402-facilitator.example.com
X402_ASSET_ADDRESS=0x1ce6222bd60923a9d5209a7e191016294dc2c961
X402_PAY_TO_ADDRESS=0x28b021c0834f5ab4b2c1e1be8431d6196d8d6ee0
X402_AMOUNT_ATOMIC=100000
X402_MAX_TIMEOUT_SECONDS=300
X402_TOKEN_NAME=Mock USD
X402_TOKEN_VERSION=1

# GIWA-28 read-only deployment status. Leave every value empty while disabled.
# Enable only after deployment receipts and the exact addresses have been checked.
GIWA_REPORT_ATTESTATIONS_ENABLED=false
GIWA_REPORT_RPC_URL=
GIWA_REPORT_EAS_ADDRESS=
GIWA_REPORT_SCHEMA_REGISTRY_ADDRESS=
GIWA_REPORT_REGISTRY_PROXY_ADDRESS=
GIWA_REPORT_CONSUMER_ADDRESS=
GIWA_REPORT_GOVERNANCE_SAFE_ADDRESS=
GIWA_REPORT_SCHEMA_UID=
GIWA_REPORT_EVIDENCE_SCHEMA_DIGEST=
# GIWA-28 authenticated synthetic testnet pilot. Enable only after DB53,
# runtime preflight, funded issuer/reviewer and the global write cap are ready.
GIWA_REPORT_SYNTHETIC_TESTNET_ENABLED=false
GIWA_REPORT_IDENTITY_HMAC_KEY=
GIWA_REPORT_ISSUER_ADDRESS=
# For Compose, mount the host directory below and use paths such as
# /run/secrets/giwa-report/issuer.json in the four settings that follow.
GIWA_REPORT_SECRETS_DIR=./disabled-secrets
GIWA_REPORT_ISSUER_KEYSTORE_PATH=
GIWA_REPORT_ISSUER_PASSWORD_FILE=
GIWA_REPORT_REVIEWER_ADDRESS=
GIWA_REPORT_REVIEWER_KEYSTORE_PATH=
GIWA_REPORT_REVIEWER_PASSWORD_FILE=
GIWA_REPORT_MIN_CONFIRMATIONS=1
GIWA_REPORT_DAILY_USER_WRITE_LIMIT=4
GIWA_REPORT_DAILY_IP_WRITE_LIMIT=20
GIWA_REPORT_DAILY_GLOBAL_WRITE_LIMIT=100

EMAIL_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-bytes
EMAIL_VERIFICATION_TTL_SECONDS=300
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_AFTER_SECONDS=60

# MVP does not use an external identity-verification provider.
IDENTITY_VERIFICATION_MODE=disabled
# R1 MVP does not compare the PDF subject name. When import is eventually
# enabled, parser evidence preserves subjectMatch=INCONCLUSIVE.
# Fail closed: the current Compose named volume is not an approved production
# object-storage boundary for private source documents.
UPBIT_PDF_IMPORT_ENABLED=false
# Raw-base64url Ed25519 public key matching the signed SOURCE publication
# policy and, after the single-writer cutover, the separately signed JIT/EVM
# publication policy provisioned under the host runtime config directory.
DAEJANG_PUBLICATION_POLICY_TRUST_KEY=replace-with-public-verification-key
# PRIVATE_OBJECT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# PRIVATE_OBJECT_ENCRYPTION_KEY_ID=primary
# PRIVATE_OBJECT_LEGACY_KEY_ID=primary
# PRIVATE_OBJECT_DECRYPTION_KEYS={"previous":"replace-with-previous-base64-key"}

ENGINE_SERVER_CERT_PATH=/secure/path/engine-server-cert.pem
ENGINE_SERVER_KEY_PATH=/secure/path/engine-server-key.pem
ENGINE_CLIENT_CA_PATH=/secure/path/engine-client-ca.pem
ENGINE_WEB_API_CLIENT_DNS_NAME=web-api.internal
ENGINE_CA_PATH=/secure/path/engine-ca.pem
WEB_ENGINE_CLIENT_CERT_PATH=/secure/path/web-engine-client-cert.pem
WEB_ENGINE_CLIENT_KEY_PATH=/secure/path/web-engine-client-key.pem
ENGINE_PROBE_CERT_PATH=/secure/path/probe-client-cert.pem
ENGINE_PROBE_KEY_PATH=/secure/path/probe-client-key.pem
SOURCE_ARTIFACT_DATABASE_URL=postgres://daejang_source_app:replace-me@postgres:5432/daejang

# sync-worker reaches separately deployed jitd over private-network TCP mTLS.
# The JSON config endpoint should be tcp://jitd.internal:50051 and its TLS
# caFile/certFile/keyFile values must be the container paths mounted below:
# /run/secrets/jit-ca.pem, /run/secrets/jit-client-cert.pem,
# /run/secrets/jit-client-key.pem. The certificate must validate the serverName
# declared in that JSON config.
JIT_BRIDGE_CONFIG_PATH=/secure/path/jit-bridge.production.json
JIT_BRIDGE_CA_PATH=/secure/path/jit-ca.pem
JIT_BRIDGE_CLIENT_CERT_PATH=/secure/path/sync-worker-jit-client-cert.pem
JIT_BRIDGE_CLIENT_KEY_PATH=/secure/path/sync-worker-jit-client-key.pem
