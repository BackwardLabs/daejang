NODE_ENV=development
# Local: 127.0.0.1. Separate ingress container: 0.0.0.0 on an internal-only network.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=43200
# Restricted pre-activation signup session. This cannot access normal user APIs.
SIGNUP_SESSION_TTL_SECONDS=3600
# MVP signup is active without an external identity-verification provider.
# Authentication and required legal consent still apply before activation.
SIGNUP_ENABLED=true
BODY_LIMIT_BYTES=1048576
TRUST_PROXY_HOPS=0
# Web API와 Sync worker가 공유하는 비공개 PDF 저장소 루트
# PRIVATE_OBJECT_ROOT=/private/tmp/daejang-private-objects
# Durable PostgreSQL store (local OrbStack example):
# DATABASE_URL=postgresql://daejang_web_app:replace-me@127.0.0.1:55432/daejang?sslmode=disable
# 로컬 Engine이 명시적으로 insecure loopback을 허용할 때만 사용합니다.
# ENGINE_GRPC_INSECURE_TARGET=127.0.0.1:50051
# Local Engine integration may opt in. R1 MVP binds uploads to the authenticated
# user but does not compare the PDF subject name; evidence remains INCONCLUSIVE.
# Production is still fail-closed until approved private object storage exists.
UPBIT_PDF_IMPORT_ENABLED=false
# Safe/ERC-1271 server-side verification RPCs.
ENV_RPC_URL_ETHEREUM_MAINNET=
ENV_RPC_URL_OPTIMISM_MAINNET=
# Base64-encoded 32-byte AES-256-GCM key; required for production PDF import.
PRIVATE_OBJECT_ENCRYPTION_KEY=
PRIVATE_OBJECT_ENCRYPTION_KEY_ID=
PRIVATE_OBJECT_LEGACY_KEY_ID=
PRIVATE_OBJECT_DECRYPTION_KEYS=

# OAuth providers. Callback URLs are derived from PUBLIC_ORIGIN and cannot be
# overridden independently:
#   ${PUBLIC_ORIGIN}/api/v1/auth/oauth/naver/callback
#   ${PUBLIC_ORIGIN}/api/v1/auth/oauth/google/callback
#   ${PUBLIC_ORIGIN}/api/v1/auth/oauth/kakao/callback
OAUTH_ENABLED_PROVIDERS=naver,google,kakao
OAUTH_TRANSACTION_TTL_SECONDS=600
# Generate independent secrets. Do not reuse provider client secrets.
OAUTH_STATE_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Base64-encoded 32-byte AES key, for example: openssl rand -base64 32
OAUTH_TRANSACTION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
NAVER_CLIENT_ID=replace-with-naver-client-id
NAVER_CLIENT_SECRET=replace-with-naver-client-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# Direct email signup and login.
EMAIL_AUTH_ENABLED=true
# Development only: bypass external delivery and accept this fixed six-digit code.
# Never set this in test or production.
EMAIL_VERIFICATION_DEV_CODE=
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=GIWA <no-reply@auth.backwardlabs.io>

# Actual FINAL report download payment (GIWA Sepolia x402 v2)
X402_REPORT_PAYMENTS_ENABLED=false
X402_FACILITATOR_URL=https://x402-facilitator.example.com
X402_ASSET_ADDRESS=0x1ce6222bd60923a9d5209a7e191016294dc2c961
X402_PAY_TO_ADDRESS=0x28b021c0834f5ab4b2c1e1be8431d6196d8d6ee0
X402_AMOUNT_ATOMIC=100000
X402_MAX_TIMEOUT_SECONDS=300
X402_TOKEN_NAME=Mock USD
X402_TOKEN_VERSION=1

# The product API never mounts the GIWA-28 synthetic report routes. Keep this
# aligned with the frontend build mode in an isolated demo deployment.
REPORTS_UI_MODE=product

# GIWA-28 production read boundary. Disabled means /reports shows a fail-closed
# preparation state. Enable only after the deployment output has been checked.
# The RPC URL stays server-side and is never returned to the browser.
GIWA_REPORT_ATTESTATIONS_ENABLED=false
GIWA_REPORT_RPC_URL=
GIWA_REPORT_EAS_ADDRESS=
GIWA_REPORT_SCHEMA_REGISTRY_ADDRESS=
GIWA_REPORT_REGISTRY_PROXY_ADDRESS=
GIWA_REPORT_CONSUMER_ADDRESS=
GIWA_REPORT_GOVERNANCE_SAFE_ADDRESS=
GIWA_REPORT_SCHEMA_UID=
GIWA_REPORT_EVIDENCE_SCHEMA_DIGEST=
# Authenticated GIWA Sepolia synthetic publication pilot. The keystore JSON and
# password files stay on the Web API host and must not be copied to the web app.
GIWA_REPORT_SYNTHETIC_TESTNET_ENABLED=false
GIWA_REPORT_IDENTITY_HMAC_KEY=
GIWA_REPORT_ISSUER_ADDRESS=
GIWA_REPORT_ISSUER_KEYSTORE_PATH=
GIWA_REPORT_ISSUER_PASSWORD_FILE=
GIWA_REPORT_REVIEWER_ADDRESS=
GIWA_REPORT_REVIEWER_KEYSTORE_PATH=
GIWA_REPORT_REVIEWER_PASSWORD_FILE=
GIWA_REPORT_MIN_CONFIRMATIONS=1
GIWA_REPORT_DAILY_USER_WRITE_LIMIT=4
GIWA_REPORT_DAILY_IP_WRITE_LIMIT=20
GIWA_REPORT_DAILY_GLOBAL_WRITE_LIMIT=100

EMAIL_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-bytes
EMAIL_VERIFICATION_TTL_SECONDS=300
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_AFTER_SECONDS=60

# MVP에서는 외부 본인확인 provider를 사용하지 않습니다.
IDENTITY_VERIFICATION_MODE=disabled

# Production-only rate-limit secret:
# RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Same-host production may use explicit loopback instead of Engine mTLS:
ENGINE_ALLOW_INSECURE_LOOPBACK=false
# ENGINE_GRPC_INSECURE_TARGET=127.0.0.1:50051
# Remote or container-network Engine connections require mTLS:
# ENGINE_GRPC_TARGET=127.0.0.1:8443
# ENGINE_GRPC_CA_PATH=/run/secrets/engine-ca.pem
# ENGINE_GRPC_CERT_PATH=/run/secrets/web-api-client.pem
# ENGINE_GRPC_KEY_PATH=/run/secrets/web-api-client-key.pem
# ENGINE_GRPC_SERVER_NAME=engine.internal
