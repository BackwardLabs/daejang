# 공개 Web API의 기준 경로입니다. 소셜 인증과 이메일 인증은 모두 이 경로를 사용합니다.
# VITE_ 변수는 브라우저에 공개되므로 Client Secret, API Key, 토큰을 넣지 않습니다.
VITE_WEB_API_BASE_URL=/api/v1
# 로컬 API 포트를 바꿀 때만 Vite proxy 대상을 덮어씁니다.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# 고객지원 페이지에 공개할 채널입니다. 운영 주소가 정해지기 전에는 비워 둡니다.
VITE_SUPPORT_KAKAO_URL=
VITE_SUPPORT_EMAIL=

# Reown Dashboard에서 발급한 공개 Project ID입니다. 도메인 allowlist와 함께 설정합니다.
VITE_REOWN_PROJECT_ID=
